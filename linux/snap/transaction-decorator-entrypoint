#!/bin/bash
# Snap entrypoint — launches the bundled PyInstaller binary.
# Python and all deps are embedded inside the binary; no system
# python3 dependency.
set -euo pipefail

SETUP_SCRIPT="$SNAP/user-data/user-data-copy.sh"

if [ ! -f "$SNAP_USER_DATA/csv/allTransactions.csv" ]; then
    echo "Setup required. Executing $SETUP_SCRIPT..."
    bash "$SETUP_SCRIPT"
else
    echo "Setup already completed."
fi

exec "$SNAP/usr/lib/transaction-decorator/TransactionDecorator" "$@"
